<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#E2E8F0" />

    <TextView
        android:id="@+id/tvPaneUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPaneUserDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="email@example.com · STU-1234"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPaneUserStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_translucent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="STATUS: ACTIVE"
        android:textColor="#16A34A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="20dp"
        android:background="#F1F5F9" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADMIN ACTIONS"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Action 1: Suspend -->
    <Button
        android:id="@+id/btnPaneSuspend"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_orange"
        android:text="Suspend Account (Timed)"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Action 2: Activate / Deactivate -->
    <Button
        android:id="@+id/btnPaneToggleActive"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_white"
        android:text="Deactivate Account"
        android:textAllCaps="false"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Action 3: Archive -->
    <Button
        android:id="@+id/btnPaneArchive"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button_white"
        android:text="Archive Account"
        android:textAllCaps="false"
        android:textColor="#EF4444"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
