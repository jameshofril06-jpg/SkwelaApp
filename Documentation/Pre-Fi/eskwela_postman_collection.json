				{
					"name": "Update User Status (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fields\": {\n    \"status\": { \"stringValue\": \"suspended\" },\n    \"suspensionDuration\": { \"stringValue\": \"24 Hours\" },\n    \"suspendedAt\": { \"integerValue\": 1715000000000 }\n  }\n}"
						},
						"url": {
							"raw": "https://firestore.googleapis.com/v1/projects/eskwela-450eb/databases/(default)/documents/users/student-uid-101?updateMask.fieldPaths=status&updateMask.fieldPaths=suspensionDuration&updateMask.fieldPaths=suspendedAt",
							"protocol": "https",
							"host": ["firestore", "googleapis", "com"],
							"path": ["v1", "projects", "eskwela-450eb", "databases", "(default)", "documents", "users", "student-uid-101"]
						}
					}
				}
			]
		},
		{
			"name": "Schedules & Timetable",
			"item": [
				{
					"name": "Get Daily Schedules",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"schedules\" }],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          {\n            \"fieldFilter\": {\n              \"field\": { \"fieldPath\": \"userId\" },\n              \"op\": \"EQUAL\",\n              \"value\": { \"stringValue\": \"student-uid-101\" }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": { \"fieldPath\": \"dateString\" },\n              \"op\": \"EQUAL\",\n              \"value\": { \"stringValue\": \"2025-05-12\" }\n            }\n          }\n        ]\n      }\n    }\n  }\n}"
						},
						"url": {
							"raw": "https://firestore.googleapis.com/v1/projects/eskwela-450eb/databases/(default)/documents:runQuery",
							"protocol": "https",
							"host": ["firestore", "googleapis", "com"],
							"path": ["v1", "projects", "eskwela-450eb", "databases", "(default)", "documents:runQuery"]
						}
					}
				}
			]
		},
		{
			"name": "AI Quizzes & Leaderboard",
			"item": [
				{
					"name": "Get Leaderboard High Scores",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"ai_quizzes\" }],\n    \"orderBy\": [{ \"field\": { \"fieldPath\": \"percentage\" }, \"direction\": \"DESCENDING\" }],\n    \"limit\": 5\n  }\n}"
						},
						"url": {
							"raw": "https://firestore.googleapis.com/v1/projects/eskwela-450eb/databases/(default)/documents:runQuery",
							"protocol": "https",
							"host": ["firestore", "googleapis", "com"],
							"path": ["v1", "projects", "eskwela-450eb", "databases", "(default)", "documents:runQuery"]
						}
					}
				}
			]
		},
